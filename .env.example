# Canonical origin for metadata, sitemap, robots and JSON-LD (lib/site-url.ts).
# Falls back to https://outubroidiomas.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://outubroidiomas.vercel.app

# Search-engine indexing (lib/indexing.ts). Anything but "true" = noindex everywhere
# (meta robots + X-Robots-Tag). Set to true in Vercel only at launch, then redeploy.
SITE_INDEXABLE=false
